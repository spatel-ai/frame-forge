# Copy to backend/.env and fill in. Never commit backend/.env.
# "mock" makes no network calls and costs nothing; "fal" makes paid calls to fal.ai.
AVATAR_PROVIDER=mock
# Your fal.ai API key; only needed when AVATAR_PROVIDER=fal.
FAL_KEY=
# Voice model: "minimax" (default, proven live) or "kokoro" (cheaper, not yet proven live).
AVATAR_VOICE=minimax
# Where photos, voices and videos are stored (default: backend/data).
AVATAR_DATA_DIR=data
# Seconds between checks for finished videos.
AVATAR_POLL_INTERVAL=5
# A video with no result after this many seconds is marked failed and its hold returned.
AVATAR_VIDEO_TIMEOUT=1800
# PostgreSQL connection (psycopg 3). The default matches `docker compose up -d db`.
DATABASE_URL=postgresql+psycopg://avatar:avatar_dev@127.0.0.1:5432/avatar
# "development" logs emails instead of sending them. Any other value refuses to start until an email
# provider exists (Q-04). "production" also lifts the daily video limit (D-046) and allows a live Razorpay key.
AVATAR_ENV=development
# Where the web app is served; emailed links point here.
AVATAR_APP_URL=http://localhost:5173
# Origins allowed to make state-changing requests (comma-separated). Other websites get 403.
AVATAR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Payments: "mock" (default) makes no network calls and moves no money; "razorpay" calls Razorpay.
# Switching to "razorpay" needs the owner's approval for that run (D-021, Gate C).
AVATAR_PAYMENTS=mock
# From the Razorpay Dashboard > Account & Settings > API Keys. Use TEST keys (rzp_test_...) until launch;
# the backend refuses a live key unless AVATAR_ENV=production. The key id is public; the secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Dashboard > Webhooks). Webhook URL and events: docs/M4-PLAN.md.
RAZORPAY_WEBHOOK_SECRET=
