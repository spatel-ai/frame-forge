# Copy to backend/.env and fill in. Never commit backend/.env.
# "mock" makes no network calls and costs nothing; "fal" makes paid calls to fal.ai.
AVATAR_PROVIDER=mock
# Your fal.ai API key; only needed when AVATAR_PROVIDER=fal.
FAL_KEY=
# Voice model: "minimax" (default, proven live) or "kokoro" (cheaper, not yet proven live).
AVATAR_VOICE=minimax
