# Copy to frontend/.env (git-ignored). The SAME variable name is set in Vercel
# (Project > Settings > Environment Variables), so local and deployed stay in step.

# The backend API. Leave empty to use a backend on this machine (http://127.0.0.1:8000).
API_TARGET=https://api.example.com

# Local development only, and only when API_TARGET is a deployed backend: the website address
# that backend accepts (its AVATAR_ALLOWED_ORIGINS). Not needed on Vercel.
API_ORIGIN=https://your-site.example.com
