# AVATAR_DOMAIN is a real domain in production (Caddy then gets an HTTPS certificate by itself)
# or ":80" for the local profile (plain http). Unset means ":80".
{$AVATAR_DOMAIN::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
	}
	# HSTS only on HTTPS connections, so the plain-http local profile never sends it.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /healthz {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
