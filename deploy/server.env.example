# Copy to deploy/server.env (git-ignored) and fill in. Used only by docker-compose.server.yml.
# The address of the API, e.g. api.example.com. Its DNS A record must point to this server.
API_DOMAIN=api.example.com
# Database password: letters and digits only (it is used inside a URL). Make one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
