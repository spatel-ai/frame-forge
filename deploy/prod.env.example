# Copy to deploy/prod.env (git-ignored) and fill in. Read by docker compose only (--env-file),
# never passed to the containers except where docker-compose.prod.yml names a variable.
# Your domain, no scheme; its DNS A record must point at this server.
AVATAR_DOMAIN=
# Database password. Letters and digits only (it is placed inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
